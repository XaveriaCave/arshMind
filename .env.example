# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="YOUR_APP_URL"

# Firebase Client Configuration (Vite needs VITE_ prefix to expose to client-side bundles)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"
VITE_FIREBASE_DATABASE_ID="" # Optional: Specify if using a non-default custom database instance

# ── Dodo Payments (server-side only, never expose to client) ──────────────────
# Get these from your Dodo Payments dashboard: https://dodopayments.com
DODO_API_KEY="your_dodo_api_key_here"
DODO_WEBHOOK_SECRET="your_dodo_webhook_signing_secret_here"

# Product IDs for the two Pro plans (create these in Dodo dashboard)
DODO_MONTHLY_PRODUCT_ID="your_monthly_product_id_here"
DODO_ONETIME_PRODUCT_ID="your_onetime_lifetime_product_id_here"

# ── Firebase Admin SDK (server-side only) ─────────────────────────────────────
# Go to: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Stringify the downloaded JSON into a single line and paste here
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"YOUR_PROJECT_ID",...}'

# ── Dev/Testing ───────────────────────────────────────────────────────────────
# Random secret to protect the dev grant-pro route (used for local testing only)
DEV_GRANT_SECRET="some_random_secret_for_local_testing"
